{
	"name": "@henrytill/hbt-js",
	"private": true,
	"description": "Heterogeneous Bookmark Transformation",
	"type": "module",
	"workspaces": [
		"packages/hbt",
		"packages/hbt-cli"
	],
	"scripts": {
		"clean": "node -e \"for (const d of ['dist', 'packages/hbt/dist', 'packages/hbt-cli/dist']) fs.rmSync(d, { recursive: true, force: true })\"",
		"prebuild": "tsc -b",
		"build": "node build.mjs",
		"fmt": "dprint fmt",
		"pretest": "npm run build",
		"test": "node --enable-source-maps --test 'packages/*/dist/test/**/*.test.js'",
		"pretest:browser": "npm run build",
		"test:browser": "node test-browser.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/henrytill/hbt-js.git"
	},
	"author": {
		"name": "Henry Till",
		"email": "henrytill@gmail.com"
	},
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/henrytill/hbt-js/issues"
	},
	"homepage": "https://github.com/henrytill/hbt-js#readme",
	"devDependencies": {
		"@dprint/json": "^0.24.0",
		"@dprint/markdown": "^0.24.0",
		"@dprint/typescript": "^0.96.1",
		"@tsconfig/node24": "^24.0.5",
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^24.13.6",
		"dprint": "^0.57.4",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	}
}
