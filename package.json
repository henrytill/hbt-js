{
	"name": "@henrytill/hbt-js",
	"private": true,
	"description": "Heterogeneous Bookmark Transformation",
	"type": "module",
	"scripts": {
		"clean": "npm run clean --workspaces --if-present && node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
		"prebuild": "tsc -b",
		"build": "node build.mjs",
		"fmt": "dprint fmt",
		"pretest": "npm run build",
		"test": "node --enable-source-maps --test 'packages/*/dist/test/**/*.test.js'",
		"pretest:browser": "npm run build",
		"test:browser": "node test-browser.mjs"
	},
	"devDependencies": {
		"@dprint/json": "^0.24.0",
		"@dprint/markdown": "^0.24.0",
		"@dprint/typescript": "^0.96.1",
		"@tsconfig/node24": "^24.0.5",
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^24.13.6",
		"dprint": "^0.57.4",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	}
}
