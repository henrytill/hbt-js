{
	"name": "hbt",
	"version": "0.1.0",
	"description": "Heterogeneous Bookmark Transformation",
	"type": "module",
	"bin": {
		"hbt": "dist/tsc/cli/cli.js"
	},
	"exports": {
		".": "./dist/tsc/src/index.js",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/tsc/src",
		"dist/tsc/cli",
		"!dist/tsc/**/*.tsbuildinfo"
	],
	"scripts": {
		"clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
		"prebuild": "tsc -b",
		"build": "node build.mjs",
		"fmt": "dprint fmt",
		"pretest": "npm run build",
		"test": "node --enable-source-maps --test 'dist/tsc/test/**/*.test.js'",
		"pretest:browser": "npm run build",
		"test:browser": "node test-browser.mjs",
		"prepack": "npm run clean && npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/henrytill/hbt-js.git"
	},
	"author": {
		"name": "Henry Till",
		"email": "henrytill@gmail.com"
	},
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/henrytill/hbt-js/issues"
	},
	"homepage": "https://github.com/henrytill/hbt-js#readme",
	"devDependencies": {
		"@dprint/json": "^0.24.0",
		"@dprint/markdown": "^0.24.0",
		"@dprint/typescript": "^0.96.1",
		"@tsconfig/node24": "^24.0.5",
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^24.13.6",
		"dprint": "^0.57.4",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"markdown-it": "^15.0.2",
		"whatwg-url": "^17.1.1",
		"yaml": "^2.9.1"
	}
}
