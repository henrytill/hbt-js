{
	// The plain node scripts at the root, each starting with
	// `// @ts-check`; node runs them as they are, so nothing is
	// emitted. rewriteRelativeImportExtensions lets test-browser.mjs
	// import test/browser/test.ts, whose types node strips.
	"extends": ["./tsconfig.base.json", "@tsconfig/node24/tsconfig.json"],
	"include": ["*.mjs"],
	"references": [{ "path": "./test/browser" }],
	"compilerOptions": {
		"allowJs": true,
		"noEmit": true,
		"rewriteRelativeImportExtensions": true
	}
}
