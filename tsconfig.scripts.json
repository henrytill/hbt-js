{
	// The plain node scripts at the root, each starting with
	// `// @ts-check`. test-browser.mjs imports test/browser/test.ts,
	// which node runs by stripping its types;
	// rewriteRelativeImportExtensions lets tsc accept the import.
	"extends": ["./tsconfig.base.json", "@tsconfig/node24/tsconfig.json"],
	"include": ["build.mjs", "test-browser.mjs"],
	"references": [{ "path": "./test/browser" }],
	"compilerOptions": {
		"allowJs": true,
		"rewriteRelativeImportExtensions": true
	}
}
