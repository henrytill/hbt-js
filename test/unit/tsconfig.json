{
	// The unit tests, which run in a browser as well as under node. They
	// are typed against the stand-ins in test/browser, and esbuild reads
	// these paths too when build.mjs bundles them for the browser, so a
	// test reaching for what a stand-in lacks fails here rather than
	// only in the browser; the emitted imports stay node:test and
	// node:assert/strict, so node runs the real ones.
	"extends": "../../tsconfig.base.json",
	"references": [
		{ "path": "../../src" },
		{ "path": "../browser" }
	],
	"compilerOptions": {
		"paths": {
			"node:test": ["../browser/test.ts"],
			"node:assert/strict": ["../browser/assert.ts"]
		}
	}
}
