{
	// The plain node scripts in this directory, each starting with
	// `// @ts-check`; node runs them as they are, so nothing is
	// emitted.
	"extends": ["../tsconfig.base.json", "@tsconfig/node24/tsconfig.json"],
	"include": ["*.mjs"],
	"compilerOptions": {
		"allowJs": true,
		"noEmit": true
	}
}
