{
	"lineWidth": 140,
	"indentWidth": 4,
	"useTabs": true,
	"typescript": {
		// Layout is mostly the author's: a construct whose first element
		// starts on a new line stays multi-line even when it would fit
		// on one, and only a line longer than lineWidth is wrapped.
		"preferSingleLine": false,
		"quoteStyle": "preferSingle",
		// "prefer" leaves out the semicolon after the last member of
		// a one-line type literal, which "always" would add.
		"semiColons": "prefer",
		"operatorPosition": "sameLine",
		"constructorType.spaceAfterNewKeyword": true,
		// Imports keep the order they were written in.
		"module.sortImportDeclarations": "maintain",
		"module.sortExportDeclarations": "maintain",
		"importDeclaration.sortNamedImports": "maintain",
		"exportDeclaration.sortNamedExports": "maintain"
	},
	"json": {
		"trailingCommas": "never",
		// Would reorder package.json's keys into dprint's conventional
		// order.
		"packageJson.applyConventions": false
	},
	"markdown": {
		"textWrap": "maintain"
	},
	// test/data is hbt-data's to format.
	"excludes": ["test/data"],
	// From node_modules rather than a URL, so the lockfile pins them
	// and formatting needs no network.
	"plugins": [
		"./node_modules/@dprint/typescript/plugin.wasm",
		"./node_modules/@dprint/json/plugin.wasm",
		"./node_modules/@dprint/markdown/plugin.wasm"
	]
}
