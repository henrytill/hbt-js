{
	// What every project shares (see tsconfig.json), and as it stands the
	// library's environment: ECMAScript and nothing else. The projects
	// that run under node extend @tsconfig/node24 after this, which
	// overrides the environment and leaves the rest.
	//
	// The checks come from @tsconfig/strictest, which sets checks alone
	// and no environment, so it sits under this one without contention.
	"extends": "@tsconfig/strictest/tsconfig.json",

	"compilerOptions": {
		// ES2025, a published edition, rather than esnext, which moves
		// under the code. Node 24 implements all of it, so the library
		// runs under the CLI, and so do current browsers.
		"target": "es2025",
		"lib": ["es2025"],
		"types": [],
		// How the package is loaded, not what platform it runs on: node
		// runs dist/tsc as it is, and a bundler reads the same files, so
		// imports must resolve as node resolves them.
		"module": "nodenext",

		// The root's own projects build into dist/tsc, mirroring the
		// tree. Each package's projects override both with the
		// package's directory and its own dist, which so mirrors the
		// package: its source in dist/src, its tests in dist/test.
		"rootDir": ".",
		"outDir": "./dist/tsc",
		"composite": true,
		"sourceMap": true,

		// What strictest leaves out; noUncheckedSideEffectImports and
		// moduleDetection "force" are TypeScript 7's defaults.
		"verbatimModuleSyntax": true
	}
}
